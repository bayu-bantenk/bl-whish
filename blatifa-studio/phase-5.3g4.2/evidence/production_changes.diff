+def _freshness_verdict(age_s: object) -> str | None:
+    """None if a reading of this age (seconds; negative = dated in the future) is current, else why it is not.
+
+    Phase 5.3g.4.2: the one fixed freshness policy. Pure: no clock, no parameters, no module-level policy. Accepted:
+    -5 <= age <= 300 (both bounds inclusive). Anything else, including a non-number, a bool, NaN or ±infinity, is
+    refused.
+    """
+    if isinstance(age_s, bool) or not isinstance(age_s, (int, float)):
+        return f"reading age is not a number ({type(age_s).__name__})"
+    if not math.isfinite(age_s):
+        return f"reading age is not finite ({age_s})"
+    if age_s < -5:
+        return "reading is dated in the future"
+    if age_s > 300:
+        return f"reading is {age_s:.0f} s old (> 300 s): not a current balance"
+    return None
+
