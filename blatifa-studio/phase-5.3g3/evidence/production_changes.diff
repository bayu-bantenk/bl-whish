+# A balance older than this is history, not a current balance (Phase 5.3g.3).
+CREDIT_EVIDENCE_MAX_AGE_S = 300
+CREDIT_EVIDENCE_MAX_CLOCK_SKEW_S = 5
+
+
+def credit_evidence(reading: BalanceReading | None, *, now: datetime | None = None,
+                    max_age_s: int = CREDIT_EVIDENCE_MAX_AGE_S) -> tuple[ReadStatus, int | None, str]:
+    """(credit_status, balance, why) for `PreflightInputs`, from a provenance-carrying balance reading.
+
+    Fail-closed: only a fresh VERIFIED_WITHOUT_INTERACTION reading yields (VERIFIED, balance). USER_REPORTED,
+    OBSERVED_IN_ALREADY_OPEN_PANEL, UNAVAILABLE, a missing reading and a stale or future-dated reading all yield
+    (UNKNOWN, None), which `preflight_gate` turns into CREDIT_UNKNOWN. There is no default and no fallback value.
+    """
+    if reading is None:
+        return ReadStatus.UNKNOWN, None, "no reading"
+    if reading.status is not BalanceStatus.VERIFIED_WITHOUT_INTERACTION or reading.verified_balance is None:
+        return ReadStatus.UNKNOWN, None, f"{reading.status.value} is not verified evidence"
+    age = ((now or datetime.now(UTC)) - parse_time(reading.read_at)).total_seconds()
+    if age < -CREDIT_EVIDENCE_MAX_CLOCK_SKEW_S:
+        return ReadStatus.UNKNOWN, None, "reading is dated in the future"
+    if age > max_age_s:
+        return ReadStatus.UNKNOWN, None, f"reading is {age:.0f} s old (> {max_age_s} s): not a current balance"
+    return ReadStatus.VERIFIED, reading.verified_balance, "fresh reading without interaction"
+
