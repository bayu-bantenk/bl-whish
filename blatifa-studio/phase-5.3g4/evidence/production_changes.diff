+def is_simulated_adapter(adapter: object) -> bool:
+    """Phase 5.3g.4: may this adapter's runner use a bare-number balance?
+
+    Inside the blatifa package exactly one adapter is a simulation: `blatifa.simulation.SimulatedFlow`. Every other
+    in-package adapter (today `flow.adapter.GoogleFlowAgentAdapter`, and any future one) is treated as live and
+    gets no bare numbers. Test doubles defined outside the package are simulations.
+    """
+    cls = type(adapter)
+    if cls.__module__ == "blatifa.simulation" and cls.__qualname__ == "SimulatedFlow":
+        return True
+    return not (cls.__module__ == "blatifa" or cls.__module__.startswith("blatifa."))
+
