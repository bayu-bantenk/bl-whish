+def approval_balance(value: object, *, simulated_adapter: bool, now: datetime | None = None) -> int | None:
+    """The balance `approval_gate` may compare against (Phase 5.3g.4).
+
+    A bare non-negative int is accepted only for a simulated adapter (offline runs; nothing is spent). For every
+    other adapter, the value must be a `BalanceReading` and goes through `credit_evidence`; anything else is None,
+    which makes `approval_gate` block with COST_OVER_BALANCE.
+    """
+    if simulated_adapter and type(value) is int and value >= 0:
+        return value
+    status, balance, _ = credit_evidence(value, now=now)
+    return balance if status is ReadStatus.VERIFIED else None
+
